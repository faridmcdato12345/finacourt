APP_NAME="FinACourt"
VITE_APP_NAME="${APP_NAME}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public legal identity shown in the Privacy Policy and Terms of Service.
# Use a monitored address that can receive privacy and legal requests.
LEGAL_OPERATOR_NAME="${APP_NAME}"
LEGAL_CONTACT_EMAIL="hello@example.com"
LEGAL_EFFECTIVE_DATE="September 2, 2026"
# Comma-separated exact reverse-proxy IPs/CIDRs and public hostnames. Leave
# empty for direct local Docker access; never use * on an internet-facing app.
TRUSTED_PROXIES=
TRUSTED_HOSTS=
SECURITY_CSP_ENABLED=false
APP_PORT=8000
APP_UID=1000
APP_GID=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SLOW_REQUEST_MS=1500
DEMAND_MINIMUM_UNIQUE_SEARCHERS=3

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_PORT_FORWARD=33060
DB_DATABASE=court_marketplace
DB_TEST_DATABASE=court_marketplace_test
DB_USERNAME=court
DB_PASSWORD=court_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAP_EMBED_BASE_URL=https://www.openstreetmap.org/export/embed.html
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ORIGIN=https://tile.openstreetmap.org
MAP_PUBLIC_BASE_URL=https://www.openstreetmap.org
MAP_FRAME_ORIGIN=https://www.openstreetmap.org
# Optional Google integrations. Keep them disabled until the project has
# approved API access, reviewed OAuth consent, and production credentials.
GOOGLE_PLACES_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_BUSINESS_PROFILE_ENABLED=false
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI="${APP_URL}/owner/google-business-profile/callback"

# Optional player/owner sign-in providers. A button is shown only when its
# enabled flag is true and all required credentials are configured.
SOCIAL_AUTH_GOOGLE_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI="${APP_URL}/auth/google/callback"

SOCIAL_AUTH_FACEBOOK_ENABLED=false
FACEBOOK_AUTH_CLIENT_ID=
FACEBOOK_AUTH_CLIENT_SECRET=
FACEBOOK_AUTH_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# "Sign in with iPhone" is provided by Sign in with Apple. Either supply a
# generated client secret, or key/team/private-key values for runtime signing.
SOCIAL_AUTH_APPLE_ENABLED=false
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_CLIENT_SECRET=
APPLE_AUTH_REDIRECT_URI="${APP_URL}/auth/apple/callback"
APPLE_AUTH_KEY_ID=
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_PRIVATE_KEY=
APPLE_AUTH_PRIVATE_KEY_PASSPHRASE=
QUEUE_CONNECTION=database
DIRECTORY_CLAIM_INVITATION_HOURS=168

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development may log mail. Production venue-claim challenges and
# court-owner booking emails require a real Laravel mail transport plus the
# Docker/supervised queue worker.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# Used only when explicitly running PlatformAdminSeeder. Never use a demo
# password outside local development.
PLATFORM_ADMIN_NAME="Platform Owner"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

BOOKING_HOLD_MINUTES=15
BOOKING_MAXIMUM_HOLD_MINUTES=60
BOOKING_MAXIMUM_PLAYER_MINUTES=1440
BOOKING_REMINDER_HOURS=24

# Customer reactivation is opt-in and in-app only by default. These values
# bound deterministic lifecycle, frequency, audience, and suggestion rules.
REACTIVATION_INACTIVE_DAYS=30
REACTIVATION_FREQUENCY_COOLDOWN_DAYS=14
REACTIVATION_AUDIENCE_LIMIT=500
REACTIVATION_SUGGESTION_HORIZON_DAYS=28

# Payment provider. Use "manual" for pay-at-venue, or "paymongo" for hosted
# online checkout after adding PayMongo keys below.
PAYMENT_PROVIDER=manual
PAYMENT_ONLINE_PROVIDER=paymongo
PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMONGO_SEND_EMAIL_RECEIPT=true
PAYMONGO_PASS_ON_FEES=false
PAYMONGO_CHECKOUT_DESCRIPTION="FinACourt court reservation"
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# Online court-price earnings become available for a manual owner payout after
# this many days. Pay-at-venue bookings are never included because the venue
# receives those payments directly.
OWNER_PAYOUT_DELAY_DAYS=2
# Smallest ready balance an owner may request (50000 = PHP 500.00).
OWNER_PAYOUT_MINIMUM_CENTAVOS=50000

# Public commercial terms for the founding-venue pilot. Fees use integer
# centavos and basis points (100 basis points = 1%). This publishes a free
# pilot by default; change the values only when the actual offer changes.
OWNER_PILOT_PLAN_NAME="Founding venue pilot"
OWNER_PILOT_MONTHLY_FEE_CENTAVOS=0
OWNER_PILOT_BOOKING_FEE_BASIS_POINTS=0
OWNER_PILOT_AVAILABILITY="Accepting pilot venues"
OWNER_SALES_EMAIL="hello@example.com"

# Local/testing only. The seeder refuses to create demo identities or metrics
# in every other APP_ENV even if this value is accidentally enabled.
PILOT_DEMO_SEED=true
