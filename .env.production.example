APP_NAME="FinACourt"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://finacourt.example.com
LEGAL_OPERATOR_NAME="FinACourt"
LEGAL_CONTACT_EMAIL=hello@finacourt.example.com
LEGAL_EFFECTIVE_DATE="September 2, 2026"

# Exact public hosts and the IP/CIDR of the trusted TLS reverse proxy.
TRUSTED_HOSTS=finacourt.example.com
TRUSTED_PROXIES=
SECURITY_CSP_ENABLED=true

APP_UID=1000
APP_GID=1000
FINACOURT_BIND_ADDRESS=127.0.0.1
FINACOURT_HTTP_PORT=8000
FINACOURT_APP_IMAGE=finacourt-app:latest
FINACOURT_WEB_IMAGE=finacourt-web:latest

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
SLOW_REQUEST_MS=1500

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=finacourt
DB_USERNAME=finacourt
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=finacourt.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Bootstrap exactly one real platform administrator with the standalone
# PlatformAdminSeeder. Keep the password in the deployment secret store.
PLATFORM_ADMIN_NAME="Platform Owner"
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@finacourt.example.com
MAIL_FROM_NAME="FinACourt"

MAP_EMBED_BASE_URL=https://www.openstreetmap.org/export/embed.html
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ORIGIN=https://tile.openstreetmap.org
MAP_PUBLIC_BASE_URL=https://www.openstreetmap.org
MAP_FRAME_ORIGIN=https://www.openstreetmap.org

GOOGLE_PLACES_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_BUSINESS_PROFILE_ENABLED=false
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=https://finacourt.example.com/owner/google-business-profile/callback

SOCIAL_AUTH_GOOGLE_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=https://finacourt.example.com/auth/google/callback

SOCIAL_AUTH_FACEBOOK_ENABLED=false
FACEBOOK_AUTH_CLIENT_ID=
FACEBOOK_AUTH_CLIENT_SECRET=
FACEBOOK_AUTH_REDIRECT_URI=https://finacourt.example.com/auth/facebook/callback

SOCIAL_AUTH_APPLE_ENABLED=false
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_CLIENT_SECRET=
APPLE_AUTH_REDIRECT_URI=https://finacourt.example.com/auth/apple/callback
APPLE_AUTH_KEY_ID=
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_PRIVATE_KEY=
APPLE_AUTH_PRIVATE_KEY_PASSPHRASE=

PAYMENT_PROVIDER=manual
PAYMENT_ONLINE_PROVIDER=paymongo
PAYMONGO_ENABLED=false
PAYMONGO_MODE=live
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHOD_TYPES=card,gcash,qrph
PAYMONGO_SEND_EMAIL_RECEIPT=true
PAYMONGO_PASS_ON_FEES=false
PAYMONGO_CHECKOUT_DESCRIPTION="FinACourt court reservation"
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

BOOKING_HOLD_MINUTES=15
BOOKING_MAXIMUM_HOLD_MINUTES=60
BOOKING_MAXIMUM_PLAYER_MINUTES=1440
BOOKING_REMINDER_HOURS=24

OWNER_PAYOUT_ENABLED=true
OWNER_PAYOUT_CURRENCY=PHP
OWNER_PAYOUT_TIMEZONE=Asia/Manila
OWNER_PAYOUT_CLEARING_HOURS=24
# Manual reconciliation is the only installed payout provider. The app fails
# closed if an unimplemented provider name is configured.
OWNER_PAYOUT_PROVIDER=manual
# Integer centavos. Set only after verifying the real transfer method fee.
OWNER_PAYOUT_TRANSFER_FEE_CENTAVOS=0
OWNER_SCHEDULED_PAYOUT_ENABLED=true
OWNER_SCHEDULED_PAYOUT_MINIMUM_CENTAVOS=100
OWNER_EARLY_PAYOUT_ENABLED=true
OWNER_EARLY_PAYOUT_MINIMUM_CENTAVOS=100
OWNER_EARLY_PAYOUT_FEE_MODE=owner
OWNER_SALES_EMAIL=hello@finacourt.example.com

DIRECTORY_CLAIM_INVITATION_HOURS=168
DEMAND_MINIMUM_UNIQUE_SEARCHERS=3
REACTIVATION_INACTIVE_DAYS=30
REACTIVATION_FREQUENCY_COOLDOWN_DAYS=14
REACTIVATION_AUDIENCE_LIMIT=500
REACTIVATION_SUGGESTION_HORIZON_DAYS=28
PILOT_DEMO_SEED=false
